{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphastore.dev/schemas/release-manifest-v1.json",
  "title": "GlyphaStore release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "abi_major", "abi_minor", "wire_version", "persistent_format_version", "git_sha", "tag", "build_metadata_ref", "provenance_subject", "provenance_ref", "compatibility_evidence_refs", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string"},
    "abi_major": {"type": "integer", "minimum": 0},
    "abi_minor": {"type": "integer", "minimum": 0},
    "wire_version": {"type": "integer", "minimum": 1},
    "persistent_format_version": {"type": "integer", "minimum": 1},
    "git_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "tag": {"type": "string"},
    "build_metadata_ref": {"type": "string"},
    "provenance_subject": {"const": "verified-seal.json"},
    "provenance_ref": {"const": "verified-seal.sigstore.json"},
    "compatibility_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "sha256", "size"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["source", "binary_package", "sbom", "provenance", "build_metadata", "candidate_admission", "evidence_import", "release_evidence"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
