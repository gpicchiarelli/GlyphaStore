{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphastore.local/schemas/requirement.schema.json",
  "title": "GlyphaStore requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "titolo",
    "categoria",
    "criticita",
    "stato",
    "descrizione",
    "autorita",
    "implementazione",
    "prove",
    "piattaforme",
    "claim_massimo",
    "evidenze",
    "rischio_residuo"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GS-[A-Z]+-[A-Z0-9]+-[0-9]{3}$"
    },
    "titolo": { "type": "string", "minLength": 1 },
    "categoria": {
      "type": "string",
      "enum": [
        "core",
        "persistence",
        "recovery",
        "concurrency",
        "protocol",
        "security",
        "operations",
        "compatibility",
        "performance"
      ]
    },
    "criticita": {
      "type": "string",
      "enum": ["critica", "alta", "media", "bassa"]
    },
    "stato": {
      "type": "string",
      "enum": [
        "bozza",
        "normativo",
        "implementato",
        "provato",
        "soddisfatto",
        "deprecato"
      ]
    },
    "descrizione": { "type": "string", "minLength": 1 },
    "autorita": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "implementazione": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prove": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "piattaforme": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "claim_massimo": { "type": "string", "minLength": 1 },
    "evidenze": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflow": { "type": "string" },
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "rischio_residuo": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "hazards": {
      "type": "array",
      "items": { "type": "string", "pattern": "^HAZ-[0-9]{3}$" }
    },
    "gates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^GATE-[A-Z0-9-]+$" }
    }
  }
}
