#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/glypha_store"

options = {
  host: "127.0.0.1",
  key_hex: "",
  value_hex: "",
  expire_at_ns: 0,
  tls: false,
  tls_ca: nil,
  tls_cert: nil,
  tls_key: nil,
  server_name: nil,
  insecure_skip_verify: false,
  burst: 32
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: glyphastore-interop --port N <put|get|erase|pipeline-put-get|expect-not-found|expect-permission-denied|burst-expect-overloaded|expect-frame-limit> [tls flags...]"
  opts.on("--host HOST", String) { |v| options[:host] = v }
  opts.on("--port PORT", Integer) { |v| options[:port] = v }
  opts.on("--key-hex HEX", String) { |v| options[:key_hex] = v }
  opts.on("--value-hex HEX", String) { |v| options[:value_hex] = v }
  opts.on("--expire-at-ns N", Integer) { |v| options[:expire_at_ns] = v }
  opts.on("--tls", "opt-in TLS 1.3") { options[:tls] = true }
  opts.on("--tls-ca PATH", String) { |v| options[:tls_ca] = v }
  opts.on("--tls-cert PATH", String) { |v| options[:tls_cert] = v }
  opts.on("--tls-key PATH", String) { |v| options[:tls_key] = v }
  opts.on("--server-name NAME", String) { |v| options[:server_name] = v }
  opts.on("--insecure-skip-verify", "lab escape: skip cert/hostname verify") { options[:insecure_skip_verify] = true }
  opts.on("--burst N", Integer) { |v| options[:burst] = v }
end
parser.parse!
command = ARGV.shift
abort(parser.help) if options[:port].nil? || command.nil? || !options[:burst].between?(1, 10_000)

def parse_hex(text)
  cleaned = text.to_s.gsub(/\s+/, "")
  return "".b if cleaned.empty?
  raise "odd hex length" if cleaned.length.odd?

  [cleaned].pack("H*")
end

def to_hex(payload)
  payload.to_s.b.unpack1("H*")
end

key = parse_hex(options[:key_hex])
value = parse_hex(options[:value_hex])
config = GlyphaStore::ClientConfig.defaults
config.host = options[:host]
config.port = options[:port]
config.tls = options[:tls]
config.tls_ca = options[:tls_ca]
config.cert_file = options[:tls_cert]
config.key_file = options[:tls_key]
config.server_name = options[:server_name]
config.insecure_skip_verify = options[:insecure_skip_verify]
client = GlyphaStore::Client.connect(config)
begin
  case command
  when "put"
    result = client.put(key, value, expire_at_ns: options[:expire_at_ns])
    abort("put not committed: #{result}") unless result.committed?
  when "get"
    puts to_hex(client.get(key))
  when "erase"
    result = client.erase(key)
    abort("erase not committed: #{result}") unless result.committed?
  when "pipeline-put-get"
    responses = client.execute_pipeline(
      [
        GlyphaStore::PipelineRequest.new(opcode: GlyphaStore::PipelineOpcode::PUT, key: key, value: value),
        GlyphaStore::PipelineRequest.new(opcode: GlyphaStore::PipelineOpcode::GET, key: key)
      ]
    )
    abort("pipeline outcomes failed") unless responses.length == 2 && responses[0].succeeded? && responses[1].succeeded?
    abort("pipeline value mismatch") unless responses[1].value == value
    puts to_hex(responses[1].value)
  when "expect-not-found"
    begin
      client.get(key)
    rescue GlyphaStore::Error => e
      unless e.category == GlyphaStore::Category::NOT_FOUND &&
             e.retryability == GlyphaStore::Retryability::NEW_ATTEMPT
        abort("GET produced unexpected error: #{e.category}")
      end
    else
      abort("GET unexpectedly found the key")
    end
  when "expect-permission-denied"
    result = client.put(key, value, expire_at_ns: options[:expire_at_ns])
    unless result.rejected? &&
           result.error&.category == GlyphaStore::Category::PERMISSION_DENIED &&
           result.error.retryability == GlyphaStore::Retryability::NEVER
      abort("PUT did not produce structured permission_denied")
    end
  when "burst-expect-overloaded"
    observed = options[:burst].times.any? do
      result = client.put(key, value, expire_at_ns: options[:expire_at_ns])
      overloaded = result.rejected? &&
                   result.error&.category == GlyphaStore::Category::OVERLOADED &&
                   result.error.retryability == GlyphaStore::Retryability::NEVER
      abort("PUT produced an unexpected result before OVERLOADED") unless overloaded || result.committed?
      overloaded
    end
    abort("PUT burst did not produce structured OVERLOADED") unless observed
  when "expect-frame-limit"
    result = client.put("limit".b, "\xA5".b * config.maximum_frame_bytes)
    unless result.rejected? &&
           result.error&.category == GlyphaStore::Category::INVALID_ARGUMENT &&
           result.error.bytes_sent.zero? &&
           result.error.retryability == GlyphaStore::Retryability::NEVER
      abort("oversized PUT did not produce the expected local rejection")
    end
  else
    abort("unknown command: #{command}")
  end
ensure
  client.close
end
